{
  "name": "CombatForge",
  "tree": {
      "$path": "Plugin/Main.server.luau",
      "Keybinds": { "$path": "Plugin/Keybinds.luau" },
      "SnapPreferences": { "$path": "Plugin/SnapPreferences.luau" },
      "UI": { "$path": "Plugin/UI.luau" },
      "Theme": { "$path": "Plugin/Theme.luau" },
      "ColourPicker": { "$path": "Plugin/ColourPicker.luau" },
      "ProjectileTrajectory": { "$path": "Runtime/ProjectileTrajectory.luau" },
      "HitboxEditor": { "$path": "Plugin/HitboxEditor.luau" },
      "HitboxTemplate": { "$path": "Runtime/Hitbox.luau" },
      "RuntimeInstaller": { "$path": "Plugin/RuntimeInstaller.luau" },
      "DummySpawner": {
        "$path": "Plugin/DummySpawner.luau",
        "IdleTemplate": { "$path": "Runtime/DummyIdle.server.luau", "$properties": { "Disabled": true } }
      },
      "TemplateInstaller": { "$path": "Plugin/TemplateInstaller.luau" },
      "MeleeToolTemplate": {
        "$className": "Tool",
        "$properties": { "RequiresHandle": false, "CanBeDropped": false, "ToolTip": "CombatForge basic melee skill" },
        "Skill": { "$path": "Templates/MeleeSkill.luau" },
        "Server": { "$path": "Templates/ToolServer.server.luau", "$properties": { "Disabled": true } },
        "Client": { "$path": "Templates/ToolClient.client.luau", "$properties": { "Disabled": true } },
        "ActivateSkill": { "$className": "RemoteEvent" }
      },
      "ProjectileToolTemplate": {
        "$className": "Tool",
        "$properties": { "RequiresHandle": false, "CanBeDropped": false, "ToolTip": "CombatForge basic projectile skill" },
        "Skill": { "$path": "Templates/ProjectileSkill.luau", "Trajectory": { "$path": "Runtime/ProjectileTrajectory.luau" } },
        "Server": { "$path": "Templates/ToolServer.server.luau", "$properties": { "Disabled": true } },
        "Client": { "$path": "Templates/ToolClient.client.luau", "$properties": { "Disabled": true } },
        "ActivateSkill": { "$className": "RemoteEvent" }
      },
      "AbilityConfig": { "$path": "Plugin/AbilityConfig.luau" },
      "AbilityManager": { "$path": "Plugin/AbilityManager.luau" }
  }
}
