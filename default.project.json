{
  "name": "CombatForge",
  "tree": {
      "$path": "Plugin/Main.server.luau",
      "UI": { "$path": "Plugin/UI.luau" },
      "Theme": { "$path": "Plugin/Theme.luau" },
      "ColourPicker": { "$path": "Plugin/ColourPicker.luau" },
      "HitboxTemplate": { "$path": "Runtime/Hitbox.luau" },
      "RuntimeInstaller": { "$path": "Plugin/RuntimeInstaller.luau" },
      "ExampleInstaller": { "$path": "Plugin/ExampleInstaller.luau" },
      "ExampleConfigTemplate": { "$path": "Examples/ExampleSlashConfig.luau" },
      "ExampleToolTemplate": {
        "$className": "Tool",
        "$properties": { "RequiresHandle": false, "CanBeDropped": false, "ToolTip": "CombatForge example: click to slash" },
        "Skill": { "$path": "Examples/ExampleSlash.luau" },
        "Server": { "$path": "Examples/ExampleTool.server.luau", "$properties": { "Disabled": true } },
        "Client": { "$path": "Examples/ExampleTool.client.luau", "$properties": { "Disabled": true } },
        "ActivateSkill": { "$className": "RemoteEvent" }
      },
      "AbilityConfig": { "$path": "Plugin/AbilityConfig.luau" },
      "AbilityManager": { "$path": "Plugin/AbilityManager.luau" }
  }
}
