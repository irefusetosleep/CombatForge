--!strict
-- Pure validation/serialization: never executes configuration scripts from a place.
local AbilityConfig = {}

export type Inputs = { Name: string, Damage: string, Cooldown: string, Range: string }
export type Config = { Name: string, Damage: number, Cooldown: number, Range: number }

function AbilityConfig.validate(inputs: Inputs): (Config?, string?)
	local name = string.match(inputs.Name, "^%s*(.-)%s*$") or ""
	if #name == 0 or #name > 64 or not string.match(name, "^[A-Za-z_][A-Za-z0-9_]*$") then
		return nil, "Name must be 1–64 letters, numbers or underscores, starting with a letter or underscore."
	end

	local values: { [string]: number } = {}
	for _, field in { "Damage", "Cooldown", "Range" } do
		local raw = (inputs :: any)[field]
		local value = tonumber(raw)
		if value == nil or value ~= value or math.abs(value) == math.huge then
			return nil, field .. " must be a finite number."
		end
		if value < 0 or (field == "Range" and value == 0) then
			return nil, field .. (if field == "Range" then " must be greater than zero." else " cannot be negative.")
		end
		values[field] = value
	end

	return { Name = name, Damage = values.Damage, Cooldown = values.Cooldown, Range = values.Range }, nil
end

function AbilityConfig.serialize(config: Config): string
	-- 17 significant digits preserve double-precision values through a source round trip.
	return string.format(
		"-- Generated by CombatForge\nreturn {\n\tName = %q,\n\tDamage = %.17g,\n\tCooldown = %.17g,\n\tRange = %.17g,\n}\n",
		config.Name, config.Damage, config.Cooldown, config.Range
	)
end

-- Read only the literal data format we own. Never require/loadstring place scripts.
-- Refuse extra fields or executable code rather than overwriting custom logic.
function AbilityConfig.parse(source: string): (Config?, string?)
	local clean = source:gsub("%-%-[^\r\n]*", "")
	local body = clean:match("^%s*return%s*{(.-)}%s*$")
	local unsupported = "This skill contains unsupported or custom Luau. Keep it unchanged and edit its ModuleScript directly."
	if not body then return nil, unsupported end
	local fields: { [string]: string } = {}
	local remaining = body
	while remaining:match("%S") do
		local key, value, rest = remaining:match("^%s*([A-Za-z_][A-Za-z0-9_]*)%s*=%s*([^,;]+)[,;](.*)$")
		if not key then
			key, value = remaining:match("^%s*([A-Za-z_][A-Za-z0-9_]*)%s*=%s*(.-)%s*$")
			rest = ""
		end
		if not key or not value or fields[key] or (key ~= "Name" and key ~= "Damage" and key ~= "Cooldown" and key ~= "Range") then
			return nil, unsupported
		end
		value = value:match("^%s*(.-)%s*$") or ""
		if key == "Name" then
			value = value:match('^"([A-Za-z_][A-Za-z0-9_]*)"$') or value:match("^'([A-Za-z_][A-Za-z0-9_]*)'$") or ""
		elseif not value:match("^[%d%.%+%-eE]+$") then
			return nil, unsupported
		end
		fields[key] = value
		remaining = rest or ""
	end
	if not fields.Name or not fields.Damage or not fields.Cooldown or not fields.Range then return nil, unsupported end
	return AbilityConfig.validate({ Name = fields.Name, Damage = fields.Damage, Cooldown = fields.Cooldown, Range = fields.Range })
end

return AbilityConfig
